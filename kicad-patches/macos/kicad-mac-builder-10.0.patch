diff --git a/kicad-mac-builder/CMakeLists.txt b/kicad-mac-builder/CMakeLists.txt
index 9b4688a..02b92d8 100644
--- a/kicad-mac-builder/CMakeLists.txt
+++ b/kicad-mac-builder/CMakeLists.txt
@@ -111,6 +111,12 @@ DECLARE_KMB_CMAKE_ARG("PYTHON_LIBRARY" ${PYTHON_INSTALL_DIR}/Python.framework/Ve
 DECLARE_KMB_CMAKE_ARG("PYTHON_SITE_PACKAGE_PATH" ${PYTHON_INSTALL_DIR}/Python.framework/Versions/Current/lib/python${PYTHON_X_Y_VERSION}/site-packages)
 DECLARE_KMB_CMAKE_ARG("PYTHON_FRAMEWORK" ${PYTHON_INSTALL_DIR}/Python.framework )
 
+# KiCad 10.0 needs nng 1.x; Homebrew now ships nng 2.x.
+if(DEFINED ENV{KMB_NNG_PREFIX})
+    DECLARE_KMB_CMAKE_ARG("NNG_INCLUDE_DIR" $ENV{KMB_NNG_PREFIX}/include )
+    DECLARE_KMB_CMAKE_ARG("NNG_LIBRARY" $ENV{KMB_NNG_PREFIX}/lib/libnng.a )
+endif()
+
 DECLARE_KMB_CMAKE_ARG("NGSPICE_INCLUDE_DIR" ${ngspice_INSTALL_DIR}/include )
 DECLARE_KMB_CMAKE_ARG("NGSPICE_LIBRARY" ${ngspice_INSTALL_DIR}/lib/libngspice.dylib )
 
diff --git a/kicad-mac-builder/ngspice.cmake b/kicad-mac-builder/ngspice.cmake
index b412e16..cd758fe 100644
--- a/kicad-mac-builder/ngspice.cmake
+++ b/kicad-mac-builder/ngspice.cmake
@@ -10,7 +10,9 @@ ExternalProject_Add(
     CONFIGURE_COMMAND ./autogen.sh
     COMMAND ./configure --prefix=${ngspice_INSTALL_DIR} --with-ngshared
         --enable-xspice --enable-cider --disable-debug --disable-openmp
-        LDFLAGS=-L/usr/local/opt/bison/lib
+        "CFLAGS=-mmacosx-version-min=${MACOS_MIN_VERSION}"
+        "LDFLAGS=-L/usr/local/opt/bison/lib -mmacosx-version-min=${MACOS_MIN_VERSION}"
+        "CXXFLAGS=-Wno-invalid-specialization -mmacosx-version-min=${MACOS_MIN_VERSION}"
     BUILD_COMMAND  ${BIN_DIR}/run-with-path.sh ${CMAKE_MAKE_PROGRAM} /usr/local/opt/bison/bin:$ENV{PATH}
     BUILD_IN_SOURCE 1
     INSTALL_COMMAND make install
