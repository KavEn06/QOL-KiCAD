+#include "connected_shape_follower.h"
+
+#include <algorithm>
+#include <complex>
+
+#include <board.h>
+#include <commit.h>
+#include <footprint.h>
+#include <geometry/seg.h>
+#include <math/util.h>
+#include <pcb_shape.h>
+
+
+static bool canJoin( const PCB_SHAPE* aShape )
+{
+    return aShape->GetShape() == SHAPE_T::SEGMENT || aShape->GetShape() == SHAPE_T::ARC;
+}
+
+
+static bool joined( const VECTOR2I& aA, const VECTOR2I& aB )
+{
+    return ( aA - aB ).SquaredEuclideanNorm()
+           <= SEG::Square( CONNECTED_SHAPE_FOLLOWER::JOIN_EPSILON );
+}
+
+
+VECTOR2I CONNECTED_SHAPE_FOLLOWER::LINK::Position() const
+{
+    return leaderStart ? leader->GetStart() : leader->GetEnd();
+}
+
+
+void CONNECTED_SHAPE_FOLLOWER::AddLeader( PCB_SHAPE* aLeader, const std::set<EDA_ITEM*>& aExcluded )
+{
+    if( !aLeader || !canJoin( aLeader ) )
+        return;
+
+    const DRAWINGS* siblings = nullptr;
+
+    if( FOOTPRINT* footprint = aLeader->GetParentFootprint() )
+        siblings = &footprint->GraphicalItems();
+    else if( BOARD* board = aLeader->GetBoard() )
+        siblings = &board->Drawings();
+
+    if( !siblings )
+        return;
+
+    for( BOARD_ITEM* sibling : *siblings )
+    {
+        if( sibling == aLeader || sibling->Type() != PCB_SHAPE_T || aExcluded.count( sibling ) )
+            continue;
+
+        PCB_SHAPE* shape = static_cast<PCB_SHAPE*>( sibling );
+
+        if( !canJoin( shape ) || shape->IsLocked() || shape->GetLayer() != aLeader->GetLayer() )
+            continue;
+
+        for( bool leaderStart : { true, false } )
+        {
+            LINK link{ aLeader, leaderStart };
+
+            for( bool followerStart : { true, false } )
+            {
+                if( !joined( followerStart ? shape->GetStart() : shape->GetEnd(), link.Position() ) )
+                    continue;
+
+                auto it = std::find_if( m_followers.begin(), m_followers.end(),
+                                        [&]( const FOLLOWER& f )
+                                        {
+                                            return f.shape == shape;
+                                        } );
+
+                if( it == m_followers.end() )
+                {
+                    FOLLOWER follower;
+                    follower.shape = shape;
+                    follower.start = shape->GetStart();
+                    follower.end = shape->GetEnd();
+
+                    if( shape->GetShape() == SHAPE_T::ARC )
+                        follower.mid = shape->GetArcMid();
+
+                    m_followers.push_back( follower );
+                    it = std::prev( m_followers.end() );
+                }
+
+                LINK& slot = followerStart ? it->startLink : it->endLink;
+
+                if( !slot.leader )
+                    slot = link;
+            }
+        }
+    }
+}
+
+
+void CONNECTED_SHAPE_FOLLOWER::Update( COMMIT& aCommit, std::vector<EDA_ITEM*>& aUpdatedItems )
+{
+    for( const FOLLOWER& follower : m_followers )
+    {
+        PCB_SHAPE* shape = follower.shape;
+        VECTOR2I   start = follower.startLink.leader ? follower.startLink.Position() : follower.start;
+        VECTOR2I   end = follower.endLink.leader ? follower.endLink.Position() : follower.end;
+
+        if( start == shape->GetStart() && end == shape->GetEnd() )
+            continue;
+
+        if( shape->GetShape() == SHAPE_T::ARC )
+        {
+            // Map the original arc onto the new chord, which keeps its included angle.
+            using CPLX = std::complex<double>;
+
+            CPLX oldChord( follower.end.x - follower.start.x, follower.end.y - follower.start.y );
+            CPLX newChord( end.x - start.x, end.y - start.y );
+
+            if( std::abs( oldChord ) < 1.0 || std::abs( newChord ) < 1.0 )
+                continue;
+
+            CPLX mid( follower.mid.x - follower.start.x, follower.mid.y - follower.start.y );
+            mid = mid * newChord / oldChord;
+
+            aCommit.Modify( shape );
+            shape->SetArcGeometry( start, start + VECTOR2I( KiROUND( mid.real() ), KiROUND( mid.imag() ) ),
+                                   end );
+        }
+        else
+        {
+            aCommit.Modify( shape );
+            shape->SetStart( start );
+            shape->SetEnd( end );
+        }
+
+        aUpdatedItems.push_back( shape );
+    }
+}
