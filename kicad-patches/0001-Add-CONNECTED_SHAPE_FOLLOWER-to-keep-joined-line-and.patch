+#ifndef CONNECTED_SHAPE_FOLLOWER_H
+#define CONNECTED_SHAPE_FOLLOWER_H
+
+#include <set>
+#include <vector>
+
+#include <math/vector2d.h>
+
+class COMMIT;
+class EDA_ITEM;
+class PCB_SHAPE;
+
+/**
+ * Keeps the ends of lines and arcs attached to the ends of shapes that are being edited.
+ *
+ * The shapes being edited are the leaders. Any other line or arc on the same layer with an end
+ * on a leader's end is a follower, and that end tracks the leader's end while the leader changes.
+ * A following arc keeps its included angle.
+ */
+class CONNECTED_SHAPE_FOLLOWER
+{
+public:
+    /// Ends closer than this are treated as joined.
+    static const int JOIN_EPSILON = 1000;
+
+    /**
+     * Record the shapes joined to the ends of \a aLeader.
+     *
+     * @param aExcluded items that must never follow (e.g. the rest of the selection).
+     */
+    void AddLeader( PCB_SHAPE* aLeader, const std::set<EDA_ITEM*>& aExcluded = {} );
+
+    /**
+     * Move the followers' ends onto the current ends of their leaders.
+     *
+     * @param aUpdatedItems receives each follower that was changed.
+     */
+    void Update( COMMIT& aCommit, std::vector<EDA_ITEM*>& aUpdatedItems );
+
+    void Clear() { m_followers.clear(); }
+
+    bool Empty() const { return m_followers.empty(); }
+
+private:
+    struct LINK
+    {
+        PCB_SHAPE* leader = nullptr;
+        bool       leaderStart = false;
+
+        VECTOR2I Position() const;
+    };
+
+    struct FOLLOWER
+    {
+        PCB_SHAPE* shape = nullptr;
+        VECTOR2I   start; ///< Geometry when the edit began, so repeated updates do not drift.
+        VECTOR2I   mid;
+        VECTOR2I   end;
+        LINK       startLink;
+        LINK       endLink;
+    };
+
+    std::vector<FOLLOWER> m_followers;
+};
+
+#endif // CONNECTED_SHAPE_FOLLOWER_H
